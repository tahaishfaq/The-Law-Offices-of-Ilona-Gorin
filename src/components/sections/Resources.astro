---
import { links } from '../../data/site';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
const articles = [
  { title: 'When Should You Hire a Personal Injury Attorney in Los Angeles?', href: links.injuryAttorneyArticle },
  { title: 'Five Things to Do After a Slip and Fall Accident in LA', href: links.slipAndFallArticle },
];
---
<section class="resources section-space" aria-labelledby="resources-title"><div class="container-site"><div class="heading"><h2 id="resources-title">Recent insights</h2><a class="text-link" href={links.blog}>View all insights ↗</a></div><div class="articles">{articles.map((article) => <article><ImagePlaceholder label="Article image placeholder" variant="landscape" /><h3><a href={article.href}>{article.title} <span aria-hidden="true">↗</span></a></h3></article>)}</div></div></section>
<style>
  .resources { background: var(--color-bg-subtle); } .heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; } .articles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 2.5rem; } article { background: var(--color-bg-surface); } h3 { font-size: 1.15rem; line-height: 1.35; } h3 a { display: flex; justify-content: space-between; gap: 1rem; padding: 1.5rem; color: var(--color-text-primary); text-decoration: none; } h3 a:hover { text-decoration: underline; } h3 span { flex: none; }
  @media (max-width: 767px) { .heading { align-items: start; flex-direction: column; } .articles { grid-template-columns: 1fr; } }
</style>
