---
import Icon from '../ui/Icon.astro';
import { links } from '../../data/site';
const areas = [
  { title: 'Personal injury', description: 'Guidance after car accidents, rideshare incidents, falls, dog bites, and other injury matters.', href: links.personalInjury, image: '/assets/personal-injury.png', link: 'Explore personal injury' },
  { title: 'Business formation & transactions', description: 'Support for new entities, agreements, contract negotiations, and business transactions.', href: links.business, image: '/assets/business-law.png', link: 'Explore business services' },
];
---
<section id="practice-areas" class="practice section-space" aria-labelledby="practice-title">
  <div class="container-site">
    <div class="heading"><h2 id="practice-title">Practice areas</h2><p>Legal help with personal injury claims, business formation, and transactions.</p></div>
    <div class="areas">
      {areas.map((area) => (
        <article class="area">
          <div class="area-image"><img src={area.image} alt="" width="1448" height="1086" loading="lazy" decoding="async" /></div>
          <div class="area-content">
            <h3>{area.title}</h3>
            <div class="area-details"><div><p>{area.description}</p></div></div>
            <a class="text-link" href={area.href}>{area.link}<Icon name="arrow-up-right" /></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .practice { padding-block: 3.75rem; }
  .heading { text-align: center; }
  .heading p { max-width: 55ch; margin: 1rem auto 0; color: var(--color-text-secondary); }
  .areas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 3rem; }
  .area { position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-width: 0; min-height: 27rem; background: var(--color-bg-inverse); color: var(--color-text-inverse); }
  .area-image { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .area-image img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: .35; outline: 1px solid rgb(255 255 255 / .1); outline-offset: -1px; }
  .area-content { position: relative; padding: clamp(1.5rem, 3vw, 2.5rem); }
  h3 { font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 800; text-transform: uppercase; }
  .area-details { display: grid; grid-template-rows: 1fr; }
  .area-details > div { min-height: 0; overflow: hidden; }
  .area p { max-width: 45ch; padding-top: .8rem; }
  .area a { margin-top: 1rem; color: var(--color-text-inverse); }
  .area a:focus-visible { outline-color: var(--color-text-inverse); }
  @media (hover: hover) and (pointer: fine) {
    .area-details { grid-template-rows: 0fr; opacity: 0; }
    .area:hover .area-details, .area:focus-within .area-details { grid-template-rows: 1fr; opacity: 1; }
    .area:hover .area-image img, .area:focus-within .area-image img { opacity: .28; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .area-details { transition: grid-template-rows 250ms ease-out, opacity 150ms ease-out; }
    .area-image img { transition: opacity 150ms ease-out; }
  }
  @media (max-width: 767px) { .areas { grid-template-columns: 1fr; margin-top: 2rem; } .area { min-height: 24rem; } }
</style>
