---
import { links, site } from '../../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container-site hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title">Personal injury and business formation</h1>
      <p>The Law Offices of Ilona Gorin provides legal guidance and attentive service tailored to each client’s needs.</p>
      <div class="hero-actions"><a class="button" href={links.contact}>Request a consultation</a><a class="text-link" href={site.phoneHref}>Call {site.phoneDisplay}</a></div>
    </div>
  </div>
</section>
<style>
  .hero { background-color: var(--color-bg-placeholder); background-image: linear-gradient(90deg, #faf9f6 0%, #faf9f6 28%, rgba(250, 249, 246, .94) 42%, rgba(250, 249, 246, .1) 78%), url("/assets/hero.png"); background-position: center; background-size: cover; }
  .hero-inner { display: flex; align-items: center; min-height: 620px; }
  .hero-copy { padding-block: clamp(4rem, 8vw, 7rem); }
  h1 { max-width: 14ch; font-size: clamp(2.4rem, 4.76vw, 3.75rem); line-height: 1.1; }
  p { max-width: 42ch; margin-top: 1.75rem; color: var(--color-text-secondary); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; margin-top: 2rem; }
  @media (max-width: 767px) { .hero { background-image: linear-gradient(rgba(250, 249, 246, .94), rgba(250, 249, 246, .94)), url("/assets/hero.png"); background-position: 65% center; } .hero-inner { min-height: 0; } h1 { font-size: clamp(2.4rem, 10vw, 3.75rem); } }
</style>
