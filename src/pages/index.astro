---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import FirmResults from '../components/sections/FirmResults.astro';
import PracticeAreas from '../components/sections/PracticeAreas.astro';
import AttorneyIntroduction from '../components/sections/AttorneyIntroduction.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import ContactCTA from '../components/sections/ContactCTA.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
---
<BaseLayout
